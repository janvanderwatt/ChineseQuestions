# Editor defaults for this project: LF everywhere, UTF-8, 2-space JS/HTML/CSS,
# 4-space PHP/Python. Pairs with .gitattributes, which forces LF in git itself.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.php]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false
